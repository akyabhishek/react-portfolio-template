# Google Analytics 4 Measurement ID
# Get yours from: https://analytics.google.com → Admin → Data Streams → Web stream
# Set this in Vercel dashboard (Settings → Environment Variables) — do NOT commit a .env file with the real ID
VITE_GA_MEASUREMENT_ID=
GA4_PROPERTY_ID=
# Server-only service-account JSON, compressed to one line and enclosed in single quotes locally.
# Enable Google Analytics Data API and grant this account Viewer access to the GA4 property.
# Never use a VITE_ prefix for credentials. Store real values in ignored .env.local or Vercel.
GA4_CREDENTIALS_JSON=